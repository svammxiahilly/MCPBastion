{
  "name": "mcp-bastion-console",
  "version": "0.1.0",
  "description": "Dependency-free policy console and audit report viewer for MCP Bastion. Uses only the Node.js standard library.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-bastion-console": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/console.test.js",
    "report": "node dist/cli.js report",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
