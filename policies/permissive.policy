# MCP Bastion — permissive development policy
#
# Allows everything except a small deny-list, with light redaction. Intended
# for local development only; NOT recommended for untrusted MCP servers.

default = allow

# Even in permissive mode, keep the truly dangerous verbs blocked.
deny_tool = shell.*
deny_tool = fs.delete
deny_tool = process.kill

# Still redact obvious credentials.
redact_arg = *token*
redact_arg = password
redact_arg = *secret*

max_bytes      = 262144   # 256 KiB
rate_limit     = 0        # unlimited
rate_window_ms = 1000
redaction_mask = "***"
