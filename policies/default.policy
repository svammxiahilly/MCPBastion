# MCP Bastion — default zero-trust policy
#
# This policy denies everything by default and only permits an explicit,
# audited allow-list of read-only tools. See ../docs/POLICY.md for the full
# directive reference.

# Fallback decision when a tool matches neither list.
default = deny

# --- Allowed tools (read-only surface) --------------------------------------
allow_tool = read_file
allow_tool = list_dir
allow_tool = search_files
allow_tool = get_metadata

# --- Explicitly denied tools (deny always wins over allow) ------------------
deny_tool  = shell.*
deny_tool  = fs.delete
deny_tool  = fs.write
deny_tool  = net.*
deny_tool  = process.*

# --- Argument redaction (values replaced before forwarding) -----------------
# `*` is a wildcard matching any run of characters.
redact_arg = *token*
redact_arg = *secret*
redact_arg = password
redact_arg = api_key
redact_arg = authorization

# --- Limits ------------------------------------------------------------------
max_bytes      = 65536     # reject any single message larger than 64 KiB
max_depth      = 32        # nesting depth flagged in audit metadata
rate_limit     = 20        # at most 20 forwarded messages ...
rate_window_ms = 1000      # ... per rolling 1000 ms window

# Replacement text spliced in place of redacted values.
redaction_mask = "«redacted»"
