# MCP Bastion — default zero-trust policy
#
# This policy denies everything by default and only permits an explicit,
# audited allow-list of read-only tools. See ../docs/POLICY.md for the full
# directive reference.

# Fallback decision when a tool matches neither list.
default = deny

# --- Allowed tools (read-only surface) --------------------------------------
allow_tool = read_file
allow_tool = list_dir
allow_tool = search_files
allow_tool = get_metadata

# --- Explicitly denied tools (deny always wins over allow) ------------------
deny_tool  = shell.*
deny_tool  = fs.delete
deny_tool  = fs.write
deny_tool  = net.*
deny_tool  = process.*

# --- Argument redaction (values replaced before forwarding) -----------------
# `*` is a wildcard matching any run of characters.
