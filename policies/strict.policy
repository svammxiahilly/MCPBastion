# MCP Bastion — strict lockdown policy
#
# The tightest sample: a single allowed tool, aggressive redaction, small
# limits, and a low rate cap. Use as a starting point for high-risk servers.

default = deny

allow_tool = read_file

# Redact anything that even smells like a credential or identifier.
redact_arg = *token*
redact_arg = *secret*
redact_arg = *key*
redact_arg = *password*
redact_arg = *auth*
redact_arg = *credential*
